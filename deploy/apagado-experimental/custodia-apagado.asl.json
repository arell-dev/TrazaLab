{
  "Comment": "BORRADOR NO DESPLEGAR: requiere preparador seguro y control de todas las rutas EC2.",
  "QueryLanguage": "JSONata",
  "TimeoutSeconds": 1800,
  "StartAt": "AdquirirPermiso",
  "States": {
    "AdquirirPermiso": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Arguments": {
        "TableName": "REEMPLAZAR_TABLA",
        "Item": {
          "pk": {"S": "trazalab-operacion"},
          "operacion": {"S": "apagado"},
          "propietario": {"S": "{% $states.context.Execution.Id %}"}
        },
        "ConditionExpression": "attribute_not_exists(pk)"
      },
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "RevisionManual"}],
      "Next": "PrepararNodo"
    },
    "PrepararNodo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "REEMPLAZAR_PREPARADOR:1",
        "Payload": {"operacion": "preparar-apagado"}
      },
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "RevisionManual"}],
      "Output": "{% $exists($states.result.FunctionError) ? {'preparado': false} : ($type($states.result.Payload) = 'string' ? $parse($states.result.Payload) : $states.result.Payload) %}",
      "Next": "ComprobarPreparacion"
    },
    "ComprobarPreparacion": {
      "Type": "Choice",
      "Choices": [{"Condition": "{% $states.input.preparado = true %}", "Next": "SolicitarParada"}],
      "Default": "RevisionManual"
    },
    "SolicitarParada": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:stopInstances",
      "Arguments": {"InstanceIds": ["REEMPLAZAR_INSTANCIA"]},
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "RevisionManual"}],
      "Output": "{% $states.result %}",
      "Next": "ComprobarSolicitud"
    },
    "ComprobarSolicitud": {
      "Type": "Choice",
      "Choices": [{"Condition": "{% $count($states.input.StoppingInstances) = 1 and $states.input.StoppingInstances[0].InstanceId = 'REEMPLAZAR_INSTANCIA' and $states.input.StoppingInstances[0].CurrentState.Name in ['stopping', 'stopped'] %}", "Next": "Esperar"}],
      "Default": "RevisionManual"
    },
    "Esperar": {"Type": "Wait", "Seconds": 10, "Next": "ConsultarEstado"},
    "ConsultarEstado": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
      "Arguments": {"InstanceIds": ["REEMPLAZAR_INSTANCIA"]},
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "RevisionManual"}],
      "Output": "{% $states.result %}",
      "Next": "ComprobarEstado"
    },
    "ComprobarEstado": {
      "Type": "Choice",
      "Choices": [
        {"Condition": "{% $count($states.input.Reservations) = 1 and $count($states.input.Reservations[0].Instances) = 1 and $states.input.Reservations[0].Instances[0].InstanceId = 'REEMPLAZAR_INSTANCIA' and $states.input.Reservations[0].Instances[0].State.Name = 'stopped' %}", "Next": "LiberarPermiso"},
        {"Condition": "{% $count($states.input.Reservations) = 1 and $count($states.input.Reservations[0].Instances) = 1 and $states.input.Reservations[0].Instances[0].InstanceId = 'REEMPLAZAR_INSTANCIA' and $states.input.Reservations[0].Instances[0].State.Name = 'stopping' %}", "Next": "Esperar"}
      ],
      "Default": "RevisionManual"
    },
    "LiberarPermiso": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Arguments": {
        "TableName": "REEMPLAZAR_TABLA",
        "Key": {"pk": {"S": "trazalab-operacion"}},
        "ConditionExpression": "#p = :propietario AND #o = :operacion",
        "ExpressionAttributeNames": {"#p": "propietario", "#o": "operacion"},
        "ExpressionAttributeValues": {
          ":propietario": {"S": "{% $states.context.Execution.Id %}"},
          ":operacion": {"S": "apagado"}
        }
      },
      "Catch": [{"ErrorEquals": ["States.ALL"], "Next": "RevisionManual"}],
      "Output": {"resultado": "instancia detenida y permiso liberado"},
      "End": true
    },
    "RevisionManual": {"Type": "Fail", "Error": "RevisionManual", "Cause": "No se confirmaron todas las etapas; revisar la operación y el bloqueo."}
  }
}
