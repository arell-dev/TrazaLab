{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AutenticacionEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "PublicarImagenTrazaLab",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:DescribeImages",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:us-east-2:970909363773:repository/trazalab"
    },
    {
      "Sid": "ConsultarServicios",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "IniciarInstanciaTrazaLab",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:us-east-2:970909363773:instance/i-08eb755e51c5be97b"
    },
    {
      "Sid": "CoordinarOperacionesTrazaLab",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:970909363773:table/trazalab-operacion",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "trazalab-operacion"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "EjecutarSoloDocumentoTrazaLab",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-2:970909363773:instance/i-08eb755e51c5be97b",
        "arn:aws:ssm:us-east-2:970909363773:document/TrazaLabDeploy"
      ]
    }
  ]
}
