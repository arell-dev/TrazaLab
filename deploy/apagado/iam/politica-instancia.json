{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OperacionesCoordinadasTrazaLab",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:970909363773:table/trazalab-operacion",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "trazalab-operacion"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        },
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    }
  ]
}
